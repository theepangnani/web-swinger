{
  "name": "web-swinger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A 3D web-swinging game prototype: Three.js rendering, custom Verlet physics, fully procedural offline assets.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "voices": "node scripts/make-voices-neural.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "esbuild": "^0.21.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
