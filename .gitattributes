# Normalise to LF in the repository so moving between Windows and
# macOS/Linux does not show every file as modified.
* text=auto eol=lf

# Generated map data: one enormous line, never worth diffing.
public/city/osm-city.json -diff linguist-generated
package-lock.json -diff linguist-generated

# Audio is binary. `text=auto` above would normally detect this, but a
# corrupted clip is a silent failure that only shows up as a click on play.
*.mp3 binary
*.wav binary
*.ogg binary
